# QuestionPilot — Environment Variables
# Copy this file to .env (backend) and frontend/.env.local (frontend)

# ─── Backend (used by docker-compose) ──────────────────────────────────

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/questionpilot

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
JWT_SECRET_KEY=change-me-in-production

# LLM API Keys (set these in production)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://717d6eb09b95cecdefa4c815d1a07ddb.ctonew.app"]

# ─── Frontend (copy to frontend/.env.local) ────────────────────────────

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=placeholder-secret-change-in-production

# Google OAuth (replace with real credentials)
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret

# Microsoft OAuth (replace with real credentials)
MICROSOFT_CLIENT_ID=placeholder-microsoft-client-id
MICROSOFT_CLIENT_SECRET=placeholder-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000